# Copy this to .env for local testing (not committed to GitHub).
# On Railway, set these under your service's Variables tab instead.

SECRET_KEY=change-me-to-something-random

# Financial Cents (requires the Scale Plan for API access)
# Get this from Financial Cents Settings -> API / Integrations
FINANCIAL_CENTS_API_KEY=

# PandaDoc
# Get this from PandaDoc Settings -> API & Integrations -> API Keys
PANDADOC_API_KEY=
# Create a template for each document in PandaDoc's template editor,
# then paste each template's ID here (found in the template's URL/settings).
PANDADOC_ENGAGEMENT_LETTER_TEMPLATE_ID=
PANDADOC_RECORDS_RELEASE_TEMPLATE_ID=
# Phase-specific engagement letter addenda (Section 3.1). SALES-TAX and
# ANNUAL-REPORT can share a single short-form template if you prefer.
PANDADOC_BOOKKEEPING_TEMPLATE_ID=
PANDADOC_CLEANUP_TEMPLATE_ID=
PANDADOC_ANNUAL_REPORT_TEMPLATE_ID=
PANDADOC_SALES_TAX_TEMPLATE_ID=
# Shared key configured on the PandaDoc webhook (Settings -> API &
# Integrations -> Webhooks), used to verify /webhooks/pandadoc/signed
# requests actually came from PandaDoc.
PANDADOC_WEBHOOK_SHARED_KEY=

# File-count anomaly threshold for the "Portal Upload Confirmed" step
# (Section 2.2) - a single upload batch at or above this size is flagged as
# possible bookkeeping/cleanup scope instead of standard document intake.
FILE_COUNT_ANOMALY_THRESHOLD=10

# Shared secret an external scheduler (Railway Cron, Zapier) sends in the
# X-Task-Secret header to call the scheduled-task endpoints:
#   POST /tasks/poll-scope-triggers        - Financial Cents scope-triggering
#                                             client tasks (Section 6.5)
#   POST /tasks/annual-reengagement-check  - annual portal-compliance
#                                             checkpoint for recurring
#                                             clients (Section 2.2), run once
#                                             a year at re-engagement time
SCHEDULED_TASK_SECRET=

# Resend (https://resend.com) - used to email the NPS digest to the admin,
# and (via the Emails.send SDK, not the raw API above) the 31-Day
# Discipline Challenge welcome/workbook emails.
RESEND_API_KEY=
# Sender address for digest emails. The default onboarding@resend.dev is
# Resend's built-in test sender - it works with no setup but can only send
# to the email address on your Resend account. Swap in a verified domain
# address before sending to anyone else.
RESEND_FROM_EMAIL=onboarding@resend.dev
# Address that receives the NPS digest when "Send test digest" is clicked
# on /dashboard
ADMIN_EMAIL=

# Postgres connection string for the 31-Day Discipline Challenge subscribers
# table (separate from the sqlite onboarding DB above). Required by
# /api/subscribe, /api/send-workbook-now, and /api/send-workbook-batch.
DATABASE_URL=

# Shared secret sent in the X-Cron-Secret header to call:
#   POST /api/send-workbook-now    - sends one subscriber their workbook now
#   POST /api/send-workbook-batch  - sends the workbook to every subscriber
#                                     due for it (2+ days post-signup),
#                                     meant to run daily via cron
# IMPORTANT: leaving this unset does not lock these routes down - an unset
# secret matches an unset header, so set this before deploying.
WORKBOOK_CRON_SECRET=

# Google Cloud Translation (Basic v2 API key) - translates client NPS
# comments into English for the admin dashboard and digest email.
GOOGLE_TRANSLATE_API_KEY=

# Supabase (https://supabase.com) - powers login for /dashboard.
# Get these from your Supabase project's Settings -> API page.
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Secret - server-side only, bypasses row-level security. Used to check the
# `admins` table. Never expose this to the browser.
SUPABASE_SERVICE_ROLE_KEY=
